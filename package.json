{
  "name": "vuebundle-noauth",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "vue-tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Bundle Vue 3 + Express (satu build) tanpa auth, backend berupa gateway passthrough ke service lain.",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "pinia": "^2.2.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.6"
  }
}
